---
import { nav, site } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = base ? `${base}/` : '/';
const pathname = Astro.url.pathname;
const current = base
  ? pathname.startsWith(base)
    ? pathname.slice(base.length) || '/'
    : pathname
  : pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5">
    <a href={home} class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-sage font-serif text-[13px] font-bold tracking-tight text-bg shadow-sm">YSL</span>
      <span class="font-serif text-lg font-semibold tracking-tight">
        <span class="en">{site.nameEn}</span><span class="zh">{site.nameZh}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href === '/' ? home : `${base}${item.href}`}
            class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive(item.href)
                ? 'bg-bg-soft text-ink'
                : 'text-ink-soft hover:bg-bg-soft hover:text-ink'
            }`}
          >
            <span class="en">{item.label.en}</span><span class="zh">{item.label.zh}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="lang-toggle"
        type="button"
        class="rounded-lg border border-line px-2.5 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:bg-bg-soft hover:text-ink"
        aria-label="Switch language"
      >
        <span class="en">中文</span><span class="zh">EN</span>
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-lg border border-line p-2 text-ink-soft md:hidden"
        aria-label="Toggle menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line/70 bg-bg px-5 py-3 md:hidden">
    {
      nav.map((item) => (
        <a
          href={`${base}${item.href === '/' ? '' : item.href}`}
          class={`block rounded-lg px-3 py-2.5 text-sm font-medium ${
            isActive(item.href) ? 'bg-bg-soft text-ink' : 'text-ink-soft'
          }`}
        >
          <span class="en">{item.label.en}</span><span class="zh">{item.label.zh}</span>
        </a>
      ))
    }
  </div>
</header>

<script>
  const toggle = document.getElementById('lang-toggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.lang === 'zh' ? 'en' : 'zh';
    html.dataset.lang = next;
    html.lang = next;
    try {
      localStorage.setItem('lang', next);
    } catch (e) {}
  });

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
