---
import Icon from './Icon.astro';

interface Props {
  paper: any;
  compact?: boolean;
}
const { paper, compact = false } = Astro.props;
const d = paper.data;
const base = import.meta.env.BASE_URL;
const teaserSrc = d.teaser ? `${base}/${String(d.teaser).replace(/^\//, '')}` : null;

const links = [
  { label: 'arXiv', href: d.arxiv },
  { label: 'Code', href: d.code },
  { label: 'Project', href: d.project },
  { label: 'Models', href: d.hf },
].filter((l) => l.href);
---

<article class="overflow-hidden rounded-2xl border border-line bg-white/60 shadow-sm transition-shadow hover:shadow-md">
  {
    teaserSrc && (
      <a href={d.project || d.arxiv} target="_blank" rel="noopener noreferrer" class="block border-b border-line/70">
        <img src={teaserSrc} alt={d.title} loading="lazy" class="w-full object-cover" />
      </a>
    )
  }
  <div class="p-6">
    <h3 class="font-serif text-xl font-semibold leading-snug">
      <a href={d.arxiv || d.project} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-blue-deep">
        {d.title}
      </a>
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
      {
        d.authors.map((a: string, i: number) => (
          <span>
            {i > 0 && ', '}
            {a === d.highlight ? <b class="font-semibold text-ink">{a}</b> : a}
          </span>
        ))
      }
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-bg-soft px-2.5 py-1 text-xs font-medium text-ink-soft">{d.venue} · {d.year}</span>
      {d.tags.map((t: string) => (
        <span class="rounded-full border border-line px-2.5 py-1 text-xs text-ink-faint">{t}</span>
      ))}
    </div>

    {
      !compact && d.abstract && (
        <p class="prose-note mt-4 text-sm">{d.abstract}</p>
      )
    }

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-bg px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-blue hover:text-blue-deep"
          >
            {l.label}
            <Icon name="external" size={13} />
          </a>
        ))
      }
    </div>

    {
      !compact && d.bibtex && (
        <details class="group mt-4">
          <summary class="cursor-pointer select-none text-xs font-medium text-ink-faint transition-colors hover:text-ink-soft">
            BibTeX
          </summary>
          <pre class="mt-2 overflow-x-auto rounded-lg bg-[#2b2f34] p-4 text-xs leading-relaxed text-[#e8e6e1]"><code>{d.bibtex}</code></pre>
        </details>
      )
    }
  </div>
</article>
