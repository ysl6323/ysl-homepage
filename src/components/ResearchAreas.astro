---
import { researchAreas } from '../config';
---

<div class="grid gap-5 md:grid-cols-2">
  {
    researchAreas.map((area) => (
      <div class="rounded-2xl border border-line bg-white/50 p-5">
        <h3 class="font-serif text-lg font-semibold text-ink">
          <span class="en">{area.title.en}</span><span class="zh">{area.title.zh}</span>
        </h3>
        <div class="mt-3 space-y-2">
          {
            area.items.map((item) => (
              <details class="group rounded-lg border border-line bg-bg transition-colors hover:border-blue/60">
                <summary class="flex cursor-pointer select-none list-none items-center justify-between gap-2 px-3 py-2 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden">
                  <span>
                    {item.term}
                    {item.future && (
                      <span class="ml-2 rounded-full bg-bg-soft px-2 py-0.5 text-[10px] font-normal text-ink-faint">
                        <span class="en">Upcoming</span><span class="zh">进行中</span>
                      </span>
                    )}
                  </span>
                  <svg class="h-3.5 w-3.5 shrink-0 text-ink-faint transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <p class="px-3 pb-3 text-sm leading-relaxed text-ink-soft">
                  <span class="en">{item.intro.en}</span><span class="zh">{item.intro.zh}</span>
                </p>
              </details>
            ))
          }
        </div>
      </div>
    ))
  }
</div>
