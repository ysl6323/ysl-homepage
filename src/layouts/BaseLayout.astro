---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const nameBoth = `${site.nameEn} · ${site.nameZh}`;
const pageTitle = title ? `${title} · ${nameBoth}` : `${nameBoth} — ${site.titleEn}`;
const desc =
  description ??
  'Shanglin Yuan (袁上林) — M.S. student at HUST Vision Lab, Huazhong University of Science and Technology. Research on Embodied AI, vision-language-action (VLA) models, world action models, and image/video generation.';
const base = import.meta.env.BASE_URL;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.nameEn,
  alternateName: [site.nameZh, 'Shanglin'],
  url: `${site.url}${base}/`,
  email: `mailto:${site.email}`,
  jobTitle: 'M.S. Student',
  worksFor: { '@type': 'Organization', name: 'HUST Vision Lab, Huazhong University of Science and Technology' },
  sameAs: [
    'https://scholar.google.com.hk/citations?user=mHuyk9MAAAAJ&hl=en',
    'https://github.com/ysl6323',
  ],
};
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:site_name" content={site.nameEn} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site.url}${base}/images/avatar.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Set language before first paint to avoid a flash of the wrong language.
      try {
        const saved = localStorage.getItem('lang');
        const lang = saved || ((navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en');
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      } catch (e) {}
    </script>
    <script is:inline>
      // Copy email to clipboard and show a brief toast.
      function copyFallback(text) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (err) {}
        ta.remove();
      }
      function showCopyToast(msg) {
        let t = document.getElementById('copy-toast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'copy-toast';
          t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#2b2f34;color:#e8e6e1;padding:8px 16px;border-radius:9999px;font-size:13px;z-index:9999;opacity:0;transition:opacity .2s;pointer-events:none;';
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.opacity = '1';
        clearTimeout(showCopyToast._t);
        showCopyToast._t = setTimeout(() => { t.style.opacity = '0'; }, 2000);
      }
      document.addEventListener('click', async (e) => {
        const el = e.target.closest('[data-copy-email]');
        if (!el) return;
        e.preventDefault();
        const email = el.getAttribute('data-copy-email');
        if (navigator.clipboard && window.isSecureContext) {
          try { await navigator.clipboard.writeText(email); } catch (err) { copyFallback(email); }
        } else {
          copyFallback(email);
        }
        const zh = document.documentElement.dataset.lang === 'zh';
        showCopyToast((zh ? '已复制邮箱：' : 'Email copied: ') + email);
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
