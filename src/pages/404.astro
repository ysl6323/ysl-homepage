---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-5 py-28 text-center">
    <p class="text-gradient font-serif text-6xl font-bold">404</p>
    <h1 class="mt-4 font-serif text-2xl font-semibold">
      <span class="en">Page not found</span><span class="zh">页面不存在</span>
    </h1>
    <p class="mt-3 text-ink-soft">
      <span class="en">The page you are looking for may have been moved or removed.</span>
      <span class="zh">你要找的页面可能已被移动或删除。</span>
    </p>
    <a
      href={`${base}/`}
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg hover:bg-blue-deep"
    >
      <span class="en">Back home</span><span class="zh">返回首页</span>
    </a>
  </section>
</BaseLayout>
