---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import { site, bio, advisors, education, socials } from '../config';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="About">
  <section class="mx-auto max-w-5xl px-5 py-14">
    <div class="flex flex-col gap-6 md:flex-row md:items-start">
      <div class="shrink-0">
        <img
          src={`${base}/images/avatar.jpg`}
          alt={site.nameEn}
          class="h-48 w-36 rounded-xl object-cover object-top shadow-xl shadow-ink/15"
        />
      </div>
      <div class="min-w-0">
        <h1 class="font-serif text-3xl font-bold tracking-tight">
          <span class="en">{site.nameEn}</span><span class="zh">{site.nameZh}</span>
        </h1>
        <p class="mt-1 text-ink-soft">
          <span class="en">{site.affiliationEn}</span><span class="zh">{site.affiliationZh}</span>
          <span class="text-ink-faint"> · </span>
          <a href={site.labUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-deep hover:underline">HUST Vision Lab</a>
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          <span class="en">{bio.en}</span><span class="zh">{bio.zh}</span>
        </p>

        <div class="mt-4 text-sm">
          <span class="text-ink-faint">
            <span class="en">Advisors: </span><span class="zh">导师：</span>
          </span>
          <span class="font-medium text-ink">
            {advisors.map((a, i) => (
              <span class="en">
                {i > 0 && ', '}
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-2 hover:text-blue-deep">{a.en}</a>
              </span>
            ))}
            {advisors.map((a, i) => (
              <span class="zh">
                {i > 0 && '、'}
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-2 hover:text-blue-deep">{a.zh}</a>
              </span>
            ))}
          </span>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2.5">
          {
            socials
              .filter((s) => s.enabled)
              .map((s) => (
                <a
                  href={s.href}
                  data-copy-email={s.key === 'email' ? site.email : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-white/60 px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-blue hover:text-blue-deep"
                >
                  <Icon name={s.key} size={15} />
                  {s.label}
                </a>
              ))
          }
        </div>
      </div>
    </div>

    <!-- Research interests -->
    <h2 class="mt-14 font-serif text-2xl font-semibold">
      <span class="en">Research Interests</span><span class="zh">研究方向</span>
    </h2>
    <div class="mt-4">
      <ResearchAreas />
    </div>

    <!-- Education -->
    <h2 class="mt-14 font-serif text-2xl font-semibold">
      <span class="en">Education</span><span class="zh">教育经历</span>
    </h2>
    <div class="mt-5 space-y-4">
      {
        education.map((item) => (
          <div class="rounded-2xl border border-line bg-white/50 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="font-medium">
                <span class="en">{item.title.en}</span><span class="zh">{item.title.zh}</span>
                <span class="text-ink-soft"> · </span>
                <span class="en">{item.org.en}</span><span class="zh">{item.org.zh}</span>
              </p>
              <span class="font-mono text-xs text-ink-faint">{item.period}</span>
            </div>
            {item.note && (
              <p class="mt-1 text-sm text-ink-faint">
                <span class="en">{item.note.en}</span><span class="zh">{item.note.zh}</span>
              </p>
            )}
          </div>
        ))
      }
    </div>

    <!-- Contact -->
    <h2 class="mt-14 font-serif text-2xl font-semibold">
      <span class="en">Contact</span><span class="zh">联系方式</span>
    </h2>
    <p class="mt-4 text-ink-soft">
      <span class="en">Feel free to reach out at </span><span class="zh">欢迎通过邮箱联系：</span>
      <a href={`mailto:${site.email}`} class="font-medium text-blue-deep hover:underline">{site.email}</a>
    </p>
  </section>
</BaseLayout>
