---
import BaseLayout from '../layouts/BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
---

<BaseLayout title="Guestbook">
  <section class="mx-auto max-w-3xl px-5 py-14">
    <h1 class="font-serif text-3xl font-bold tracking-tight">
      <span class="en">Guestbook</span><span class="zh">留言板</span>
    </h1>
    <p class="mt-3 text-ink-soft">
      <span class="en">Leave a message, say hi, or ask a question — comments are powered by GitHub Discussions.</span>
      <span class="zh">欢迎留言、打个招呼或提问——评论由 GitHub Discussions 驱动。</span>
    </p>
    <Giscus />
  </section>
</BaseLayout>
