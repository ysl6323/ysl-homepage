---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PaperCard from '../components/PaperCard.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import { getCollection } from 'astro:content';
import {
  site,
  bio,
  advisors,
  socials,
  news,
  education,
  researchTimeline,
  noteCategories,
} from '../config';

const base = import.meta.env.BASE_URL;

const papers = (await getCollection('papers')).sort((a, b) => a.data.order - b.data.order);
const latestNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
const catOf = (id: string) => noteCategories.find((c) => c.id === id)!;

const tlStart = '2024-09';
const tlEnd = '2026-08';
const monthIdx = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return (y - 2024) * 12 + (m - 9);
};
const tlTotal = monthIdx(tlEnd) - monthIdx(tlStart) + 1;
const bars = researchTimeline.map((p) => {
  const s = monthIdx(p.start);
  const e = monthIdx(p.end);
  return { ...p, left: (s / tlTotal) * 100, width: ((e - s + 1) / tlTotal) * 100 };
});
const tlTicks = [
  { label: tlStart.replace('-', '.'), pct: 0 },
  ...researchTimeline.slice(1).map((p) => ({ label: p.start.replace('-', '.'), pct: (monthIdx(p.start) / tlTotal) * 100 })),
  { label: tlEnd.replace('-', '.'), pct: 100 },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="gradient-accent border-b border-line/60">
    <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-14 md:grid-cols-[1fr_auto] md:py-20">
      <div>
        <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight md:text-5xl">
          <span class="en">{site.nameEn}</span><span class="zh">{site.nameZh}</span>
        </h1>
        <p class="mt-2 text-sm text-ink-soft">
          <span class="en">{site.affiliationEn}</span><span class="zh">{site.affiliationZh}</span>
          <span class="text-ink-faint"> · </span>
          <a href={site.labUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-deep hover:underline">HUST Vision Lab</a>
        </p>

        <p class="mt-5 max-w-xl leading-relaxed text-ink-soft">
          <span class="en">{bio.en}</span><span class="zh">{bio.zh}</span>
        </p>

        <div class="mt-3 text-sm">
          <span class="text-ink-faint">
            <span class="en">Advisors: </span><span class="zh">导师：</span>
          </span>
          <span class="font-medium text-ink">
            {advisors.map((a, i) => (
              <span class="en">
                {i > 0 && ', '}
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-2 hover:text-blue-deep">{a.en}</a>
              </span>
            ))}
            {advisors.map((a, i) => (
              <span class="zh">
                {i > 0 && '、'}
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-2 hover:text-blue-deep">{a.zh}</a>
              </span>
            ))}
          </span>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          {
            socials
              .filter((s) => s.enabled)
              .map((s) => (
                <a
                  href={s.href}
                  data-copy-email={s.key === 'email' ? site.email : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex items-center gap-2 rounded-full border border-line bg-white/60 px-3.5 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-blue hover:text-blue-deep"
                >
                  <Icon name={s.key} size={15} />
                  {s.label}
                </a>
              ))
          }
          <a
            href={`${base}/about`}
            class="inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-blue-deep"
          >
            <span class="en">More about me</span><span class="zh">了解更多</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>

      <div class="mx-auto">
        <img
          src={`${base}/images/avatar.jpg`}
          alt={site.nameEn}
          class="h-56 w-44 rounded-xl object-cover object-top shadow-xl shadow-ink/15"
        />
      </div>
    </div>
  </section>

  <!-- Research interests -->
  <section class="mx-auto max-w-5xl px-5 py-12">
    <h2 class="font-serif text-2xl font-semibold">
      <span class="en">Research Interests</span><span class="zh">研究方向</span>
    </h2>
    <div class="mt-5">
      <ResearchAreas />
    </div>
  </section>

  <!-- Research experience (timeline) -->
  <section class="mx-auto max-w-5xl px-5 pb-12">
    <h2 class="font-serif text-2xl font-semibold">
      <span class="en">Research Experience</span><span class="zh">研究经历</span>
    </h2>

    <div class="mt-6">
      <div class="grid grid-cols-[6.5rem_1fr_8.5rem] items-end gap-3">
        <span></span>
        <div class="relative h-5">
          {
            tlTicks.map((t, i) => (
              <span
                class={`absolute top-0 font-mono text-[11px] text-ink-faint ${
                  i === 0 ? '' : i === tlTicks.length - 1 ? '-translate-x-full' : '-translate-x-1/2'
                }`}
                style={`left:${t.pct}%`}
              >
                {t.label}
              </span>
            ))
          }
        </div>
        <span></span>
      </div>

      <div class="mt-3 space-y-3">
        {
          bars.map((b) => (
            <div class="grid grid-cols-[6.5rem_1fr_8.5rem] items-center gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium">
                  {b.link ? (
                    <a href={b.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-deep hover:underline">{b.name}</a>
                  ) : (
                    <span>{b.name}</span>
                  )}
                </p>
              </div>
              <div class="relative h-10 rounded-full bg-bg-soft/70">
                <div class="absolute inset-y-1 flex items-center justify-center gap-2 rounded-full bg-sage/60 px-3" style={`left:${b.left}%; width:${b.width}%`}>
                  {b.logos.map((logo) => (
                    <a href={logo.href} target={logo.href ? '_blank' : undefined} rel="noopener noreferrer" title={logo.alt} class="flex h-8 w-8 items-center justify-center">
                      <img src={logo.src.startsWith('http') ? logo.src : `${base}/${logo.src}`} alt={logo.alt} loading="lazy" class="max-h-7 max-w-8 object-contain" />
                    </a>
                  ))}
                </div>
              </div>
              <span class="text-right font-mono text-[11px] text-ink-faint">{b.period}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="mx-auto max-w-5xl px-5 pb-12">
    <h2 class="font-serif text-2xl font-semibold">
      <span class="en">News</span><span class="zh">动态</span>
    </h2>
    <ol class="relative mt-6 space-y-6 border-l border-line/70 pl-6">
      {
        news.map((n) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full border-2 border-bg bg-sage-deep"></span>
            <span class="font-mono text-xs font-medium text-rust">{n.date}</span>
            <p class="mt-0.5 text-ink-soft">
              <span class="en">{n.text.en}</span><span class="zh">{n.text.zh}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Selected publications -->
  <section class="mx-auto max-w-5xl px-5 pb-12">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-serif text-2xl font-semibold">
        <span class="en">Publications</span><span class="zh">论文</span>
      </h2>
      <a href={`${base}/publications`} class="text-sm font-medium text-blue-deep hover:underline">
        <span class="en">All publications →</span><span class="zh">全部论文 →</span>
      </a>
    </div>
    <div class="grid gap-6">
      {papers.map((p) => <PaperCard paper={p} compact />)}
    </div>
  </section>

  <!-- Education -->
  <section class="mx-auto max-w-5xl px-5 pb-12">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-serif text-2xl font-semibold">
        <span class="en">Education</span><span class="zh">教育经历</span>
      </h2>
      <a href={`${base}/about`} class="text-sm font-medium text-blue-deep hover:underline">
        <span class="en">Full bio →</span><span class="zh">完整履历 →</span>
      </a>
    </div>
    <div class="space-y-4">
      {education.map((item) => (
        <div class="flex flex-col gap-1 rounded-2xl border border-line bg-white/50 p-5 sm:flex-row sm:items-center sm:gap-6">
          <span class="shrink-0 font-mono text-xs font-medium text-ink-faint sm:w-40">{item.period}</span>
          <div>
            <p class="font-medium">
              <span class="en">{item.title.en}</span><span class="zh">{item.title.zh}</span>
            </p>
            <p class="text-sm text-ink-soft">
              <span class="en">{item.org.en}</span><span class="zh">{item.org.zh}</span>
            </p>
            {
              item.note && (
                <p class="text-sm text-ink-faint">
                  <span class="en">{item.note.en}</span><span class="zh">{item.note.zh}</span>
                </p>
              )
            }
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Latest notes -->
  <section class="mx-auto max-w-5xl px-5 pb-20">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-serif text-2xl font-semibold">
        <span class="en">Recent Notes</span><span class="zh">最新随笔</span>
      </h2>
      <a href={`${base}/notes`} class="text-sm font-medium text-blue-deep hover:underline">
        <span class="en">All notes →</span><span class="zh">全部随笔 →</span>
      </a>
    </div>
    <div class="grid gap-4">
      {
        latestNotes.map((n) => {
          const c = catOf(n.data.category);
          return (
            <a
              href={`${base}/notes/${n.id}`}
              class="group flex items-center gap-4 rounded-2xl border border-line bg-white/50 p-5 transition-colors hover:border-blue/60"
            >
              <span class="text-2xl">{c.icon}</span>
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium group-hover:text-blue-deep">{n.data.title}</p>
                {n.data.summary && <p class="truncate text-sm text-ink-faint">{n.data.summary}</p>}
              </div>
              <div class="shrink-0 text-right">
                <span class="block rounded-full bg-bg-soft px-2.5 py-1 text-xs text-ink-soft">
                  <span class="en">{c.label.en}</span><span class="zh">{c.label.zh}</span>
                </span>
                <span class="mt-1 block font-mono text-xs text-ink-faint">{fmtDate(n.data.date)}</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
